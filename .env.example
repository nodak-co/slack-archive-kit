# 슬랙 보관함 설정 — 이 파일을 $SLACK_ARCHIVE_HOME/.env (기본 ~/slack-archive/.env)로 복사하고 `chmod 600` 한다.
# 실제 값은 이 폴더(스킬)에 두지 않는다. 깃에 올리지 않는다.

# ── 받기 (필수) ──
SLACK_BOT_TOKEN=xoxb-여기에-봇-토큰
SLACK_TEAM_ID=T0000000000          # 워크스페이스 ID (슬랙 앱 화면 주소나 auth.test 결과의 team_id)
# SLACK_TEAM_NAME=우리회사          # 화면 제목 (비우면 슬랙이 알려주는 이름)
# SLACK_ARCHIVE_HOME=~/slack-archive  # DB·JSON·로그가 모이는 폴더
# SLACK_DB=                         # 기본 $SLACK_ARCHIVE_HOME/slack.db
# SLACK_DATA_DIR=                   # 기본 $SLACK_ARCHIVE_HOME/data

# ── 보기 화면: 공개 모드(기본, Sign in with Slack) ──
AUTH_MODE=slack                           # slack(기본) | google | tailnet
PORT=43140
PUBLIC_URL=https://archive.내도메인.com   # Cloudflare Tunnel 로 여는 주소 (https 필수)
SLACK_CLIENT_ID=0000000000.0000000000     # 슬랙 앱 > Basic Information
SLACK_CLIENT_SECRET=여기에-client-secret
SESSION_SECRET=여기에-무작위-48자-이상   # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# SESSION_DAYS=7
# SLACK_LOGIN_SCOPE=openid profile email

# ── 보기 화면: 구글 회사계정 모드 (AUTH_MODE=google) — PUBLIC_URL·SESSION_SECRET 도 위 것 사용 ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HD=회사도메인.com                # 이 도메인 계정만 (Workspace 계정). 슬랙 봇에 users:read.email 필요

# ── 보기 화면: 테일넷 모드 (AUTH_MODE=tailnet) ──
# SLACK_VIEWER_ACCESS=~/slack-archive/viewer-access.json   # {"사람@메일": "U슬랙ID"} 를 손으로 관리

# ── 시험용 (공개 배포에서는 절대 켜지 않는다. PUBLIC_URL 이 있으면 서버가 거부함) ──
# DEV_USER=U0000000000

# ── 봇 CLI(archive.py)가 만드는 링크의 기준 주소 (비우면 PUBLIC_URL) ──
# ARCHIVE_BASE_URL=https://archive.내도메인.com

# ── 경보 (선택) — 이어 받기가 실패하면 이 채널에 한 줄. 봇에 chat:write 권한 + 채널 초대 필요 ──
# ALERT_SLACK_CHANNEL=C0000000000

# ── 월별 암호화 백업 (선택) ──
# SLACK_BACKUP_KEY=여기에-긴-암호          # 비밀번호 관리자에도 한 부 (잃으면 복구 불가)
# BACKUP_DEST=/Volumes/백업디스크/slack-archive   # 로컬/외장 폴더, 또는 rclone remote: 내remote:버킷/slack
